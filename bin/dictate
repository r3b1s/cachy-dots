#!/bin/sh
# dictate toggle | pre | paste
#
#   toggle  start or stop a dictation (`voxtype record toggle`), silently: voxtype's
#           own sounds mark the start and the end (its notifications are off in
#           voxtype/config.toml too). $mod+d in both sessions.
#   pre     voxtype's pre_output_command (voxtype/config.toml). Under Hyprland it
#           enters the dictate_suppress submap (hypr/cachy.lua), which swallows
#           the modifier keys while the text is pasted, since wtype cannot clear
#           physically held ones the way xdotool --clearmodifiers does. Delete
#           leaves the submap by hand. Nothing to do on X11.
#   paste   voxtype's post_output_command. The text is already in the CLIPBOARD
#           (voxtype's wl-copy or xclip driver); copy it to PRIMARY as well, since
#           terminals paste one and GTK the other, and send Shift+Insert, which
#           pastes whichever the focused app reads. Under Hyprland it then leaves
#           the suppress submap.
set -eu

wayland=false
[ "${XDG_SESSION_TYPE:-}" = wayland ] && wayland=true

case "${1:-}" in
    toggle)
        command -v voxtype >/dev/null || { dunstify -a dictate -u critical "voxtype is not installed"; exit 1; }
        exec voxtype record toggle
        ;;
    pre)
        if $wayland; then
            hyprctl dispatch 'hl.dsp.submap("dictate_suppress")' >/dev/null
        fi
        ;;
    paste)
        # The selection helpers (xclip -i, wl-copy) fork a process that owns the
        # selection and keeps the stdout and stderr it inherited open until
        # something else takes it. voxtype waits for this hook's pipes to close,
        # so with them inherited it never finished: no end-of-dictation sound, the
        # notification left up, and the next toggle refused. Hence every
        # descriptor of that process is redirected.
        if $wayland; then
            wl-paste --no-newline 2>/dev/null \
                | wl-copy --primary >/dev/null 2>&1 || true
            wtype -M shift -k Insert -m shift || true
            exec hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
        fi
        xclip -selection clipboard -o 2>/dev/null \
            | xclip -selection primary -i >/dev/null 2>&1 || true
        exec xdotool key --clearmodifiers shift+Insert
        ;;
    *) echo "usage: dictate toggle|pre|paste" >&2; exit 1 ;;
esac
