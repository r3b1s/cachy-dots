#!/bin/sh
# dictate daemon | toggle | pre | paste
#
# voxtype is opt-in: opt/services/voxtype/install.sh installs it.
#
#   daemon  start voxtype's daemon for this session. Run at login by the session
#           hooks the installer writes (06-services.conf, cachy-services.lua), not
#           by voxtype.service, which hangs off graphical-session.target, and
#           neither session reaches it. A daemon left by the other session
#           carries that session's environment, so it is stopped first, and the
#           new one starts only once it has gone: voxtype holds a lock until it
#           exits, and refuses to start while another holds it. It then waits
#           for WirePlumber's default sink (about 5 s at most): voxtype opens its
#           sound output once, at start, and opened before there is a sink,
#           PipeWire's ALSA plugin may negotiate the stream at 1 Hz, so the start
#           and stop sounds are never heard. The wait reads wpctl's output
#           ("Volume: ..."), not its exit status: `wpctl get-volume` exits 0 when
#           there is no sink, so the status passes at once.
#   toggle  start or stop a dictation (`voxtype record toggle`), silently: voxtype's
#           own sounds mark the start and the end (its notifications are off in
#           opt/services/voxtype/config.toml too). $mod+d in both sessions.
#   pre     voxtype's pre_output_command (opt/services/voxtype/config.toml). Under
#           Hyprland it enters the dictate_suppress submap (hypr/cachy.lua), which
#           swallows the modifier keys while the text is pasted, since wtype
#           cannot clear physically held ones the way xdotool --clearmodifiers
#           does. Delete leaves the submap by hand. Nothing to do on X11.
#   paste   voxtype's post_output_command. The text is already in the CLIPBOARD
#           (voxtype's wl-copy or xclip driver); copy it to PRIMARY as well, since
#           terminals paste one and GTK the other, and send Shift+Insert, which
#           pastes whichever the focused app reads. Under Hyprland it then leaves
#           the suppress submap.
set -eu

wayland=false
[ "${XDG_SESSION_TYPE:-}" = wayland ] && wayland=true

case "${1:-}" in
    daemon)
        command -v voxtype >/dev/null || exit 0
        uid=$(id -u)
        if pkill -x -u "$uid" voxtype; then
            i=0
            while pgrep -x -u "$uid" voxtype >/dev/null; do
                [ "$i" -lt 50 ] || { pkill -KILL -x -u "$uid" voxtype || true; sleep 0.2; break; }
                sleep 0.1; i=$((i + 1))
            done
        fi
        if command -v wpctl >/dev/null; then
            i=0
            until wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>&1 | grep -q '^Volume:' || [ "$i" -ge 50 ]; do
                sleep 0.1; i=$((i + 1))
            done
        fi
        exec voxtype -q daemon
        ;;
    toggle)
        command -v voxtype >/dev/null || { dunstify -a dictate -u critical "voxtype is not installed (opt/services/voxtype/install.sh)"; exit 1; }
        exec voxtype record toggle
        ;;
    pre)
        if $wayland; then
            hyprctl dispatch 'hl.dsp.submap("dictate_suppress")' >/dev/null
        fi
        ;;
    paste)
        # The selection helpers (xclip -i, wl-copy) fork a process that owns the
        # selection and keeps the stdout and stderr it inherited open until
        # something else takes it. voxtype waits for this hook's pipes to close,
        # so with them inherited it never finished: no end-of-dictation sound, the
        # notification left up, and the next toggle refused. Hence every
        # descriptor of that process is redirected.
        if $wayland; then
            wl-paste --no-newline 2>/dev/null \
                | wl-copy --primary >/dev/null 2>&1 || true
            wtype -M shift -k Insert -m shift || true
            exec hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
        fi
        xclip -selection clipboard -o 2>/dev/null \
            | xclip -selection primary -i >/dev/null 2>&1 || true
        exec xdotool key --clearmodifiers shift+Insert
        ;;
    *) echo "usage: dictate daemon|toggle|pre|paste" >&2; exit 1 ;;
esac
