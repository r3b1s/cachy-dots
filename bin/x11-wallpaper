#!/bin/sh
# x11-wallpaper [random|next|current] — set the wallpaper from the active theme.
#
# Images come from the theme's backgrounds/ (staged by x11-theme into
# ~/.local/state/omarchy/current/theme/backgrounds) plus your own extras for that
# theme in ~/.config/omarchy/backgrounds/<theme>/, the same places omarchy looks.
# With no theme, or a theme without backgrounds, ~/.config/wallpapers is used.
#
#   random   (default) any image; i3 runs this on every start and reload, so
#            $mod+Shift+r reshuffles
#   next     the one after the current, in name order ($mod+Ctrl+w)
#   current  repaint the current one (used by x11-theme after a switch only
#            when it still belongs to the theme)
#
# Deliberately plain: just fill the root window. An earlier version also cleared
# the root window first and passed --bg-size, both to work around a geometry
# problem that turned out to be a second X screen; --bg-size left a seam and
# neither is needed now that bin/x11-monitor keeps one screen at one size.
set -u

mode="${1:-random}"
state="$HOME/.local/state/omarchy/current"
theme_name=$(cat "$state/theme.name" 2>/dev/null || true)
legacy="${XDG_CONFIG_HOME:-$HOME/.config}/wallpapers"
urgency="low"
timeout=5

notify() {
    command -v dunstify >/dev/null || return 0
    dunstify -a cachy-dots -r 9989 -u "$urgency" -t "$timeout" "Wallpaper" "$1"
}

list_images() {
    for dir in "$@"; do
        [ -d "$dir" ] || continue
        find -L "$dir" -maxdepth 1 -type f -not -name '.*' \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) \
            -print 2>/dev/null
    done | sort
}

images=$(list_images "$state/theme/backgrounds" \
    ${theme_name:+"${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/backgrounds/$theme_name"})
[ -n "$images" ] || images=$(list_images "$legacy")

if [ -z "$images" ]; then
    echo "x11-wallpaper: no images for theme '${theme_name:-none}' or in $legacy" >&2
    urgency="normal"
    timeout=0
    notify "no images for theme '${theme_name:-none}'"
    exit 0
fi

current=$(readlink "$state/background" 2>/dev/null || true)
case "$mode" in
    random)  wallpaper=$(printf '%s\n' "$images" | shuf -n 1) ;;
    next)    wallpaper=$(printf '%s\n' "$images" | awk -v cur="$current" '
                 NR == 1 { first = $0 } found { print; done = 1; exit } $0 == cur { found = 1 }
                 END { if (!done) print first }') ;;
    current) if printf '%s\n' "$images" | grep -qxF -- "$current"; then wallpaper=$current
             else wallpaper=$(printf '%s\n' "$images" | head -n 1); fi ;;
    *) echo "usage: x11-wallpaper [random|next|current]" >&2; exit 2 ;;
esac

if command -v feh >/dev/null && feh --bg-fill "$wallpaper"; then
    mkdir -p "$state" "$legacy"
    # omarchy's pointer to the current background, and a stable one for
    # qutebrowser's startpage, which reaches it as ../wallpapers/current from
    # ~/.config/qutebrowser/startpage.html. feh's own record in ~/.fehbg is a
    # shell script, not an image the browser can render.
    ln -sfn "$wallpaper" "$state/background"
    ln -sf "$(readlink -f "$wallpaper")" "$legacy/current" 2>/dev/null || true
    [ "$mode" = current ] || notify "$(basename "$wallpaper")"
else
    echo "x11-wallpaper: feh failed for $wallpaper" >&2
fi
