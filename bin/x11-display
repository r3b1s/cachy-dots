#!/bin/sh
# x11-display — set up the outputs, then the wallpaper. Meant for i3's
# exec_always (every start and reload), but that line in 05-autostart.conf is
# commented out: the monitor layout is per host now, in conf.d/04-monitors.conf.
#
#   in a VM:      bin/x11-monitor pins 1920x1080 (the SPICE display otherwise comes
#                 up at whatever size the last client asked for)
#   bare metal:   autorandr applies the saved profile matching the connected
#                 outputs, or lays them out left to right when none matches.
#                 Arrange them with arandr, then `autorandr --save <name>`.
#
# The wallpaper comes after, in the same process: painted before the resolution
# change, feh's root pixmap would be tiled across the larger screen (see
# 05-autostart.conf).
bin=$(dirname "$(readlink -f "$0")")
if systemd-detect-virt -q --vm; then
    "$bin/x11-monitor" 1920x1080
elif command -v autorandr >/dev/null; then
    autorandr --change --default horizontal >/dev/null 2>&1 || true
fi
exec "$bin/x11-wallpaper"
