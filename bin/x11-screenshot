#!/bin/sh
# x11-screenshot region|full|annotate-region|annotate-full|ocr
#
# maim screenshots (grim/slurp replacement).
#   region:          interactive selection, copied to the clipboard
#   full:            whole screen, saved to ~/Pictures and copied to the clipboard
#   annotate-region: interactive selection, opened in satty to draw on
#   annotate-full:   whole screen, opened in satty to draw on
#   ocr:             interactive selection, its text (tesseract) to the clipboard
#
# In satty (config in satty/config.toml): Enter copies to the clipboard and
# closes, Ctrl+S saves to ~/Pictures/Screenshots, Escape discards.
set -eu

annotate() {
    mkdir -p "${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
    satty --filename - "$@"
}

case "${1:-region}" in
    region)
        maim -s -u | xclip -selection clipboard -t image/png
        dunstify -a x11-screenshot "Screenshot" "Region copied to clipboard"
        ;;
    full)
        dir="${XDG_PICTURES_DIR:-$HOME/Pictures}"
        mkdir -p "$dir"
        file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"
        maim -u "$file"
        xclip -selection clipboard -t image/png < "$file"
        dunstify -a x11-screenshot "Screenshot" "Saved $file"
        ;;
    annotate-region)
        # Capture first, so a cancelled selection never opens an empty editor.
        tmp=$(mktemp --suffix=.png)
        trap 'rm -f "$tmp"' EXIT
        maim -s -u "$tmp" || exit 0
        annotate < "$tmp"
        ;;
    annotate-full)
        maim -u | annotate --fullscreen
        ;;
    ocr)
        # Upscaled 2x before recognition: screen text is small, and tesseract is
        # tuned for ~300 dpi scans, so it misreads 1:1 UI text far more often.
        tmp=$(mktemp --suffix=.png)
        trap 'rm -f "$tmp"' EXIT
        maim -s -u "$tmp" || exit 0
        text=$(magick "$tmp" -resize 200% -colorspace Gray png:- | tesseract stdin stdout --psm 6 2>/dev/null \
               | sed -e 's/[[:space:]]*$//' -e '/./,$!d')
        if [ -z "$text" ]; then
            dunstify -a x11-screenshot "Text capture" "No text found"
            exit 0
        fi
        printf '%s' "$text" | xclip -selection clipboard
        dunstify -a x11-screenshot "Text copied" "$(printf '%s' "$text" | head -c 120)"
        ;;
    *) echo "usage: x11-screenshot region|full|annotate-region|annotate-full|ocr" >&2; exit 1 ;;
esac
