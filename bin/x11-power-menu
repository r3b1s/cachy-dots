#!/bin/sh
# System menu via rofi: lock / suspend / logout / reboot / poweroff.
set -eu

choice=$(printf 'lock\nsuspend\nlogout\nreboot\npoweroff\n' | rofi -dmenu -i -p 'system') || exit 0

case "$choice" in
    # Not exec'd: x11-lock lives next to this script in ~/.local/bin.
    lock)     exec "$(dirname "$0")/x11-lock" ;;
    suspend)  exec systemctl suspend ;;
    logout)   exec i3-msg exit ;;
    reboot)   exec systemctl reboot ;;
    poweroff) exec systemctl poweroff ;;
esac
