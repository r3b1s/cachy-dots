#!/bin/sh
# System menu via rofi: lock / suspend / logout / reboot / poweroff, and the
# power profile (power-profiles-daemon) when the machine offers one.
set -eu

profile=""
if command -v powerprofilesctl >/dev/null && current=$(powerprofilesctl get 2>/dev/null); then
    profile="power profile: $current"
fi

choice=$({ printf 'lock\nsuspend\nlogout\nreboot\npoweroff\n'; [ -z "$profile" ] || printf '%s\n' "$profile"; } \
         | rofi -dmenu -i -p 'system') || exit 0

case "$choice" in
    # Not exec'd: x11-lock lives next to this script in ~/.local/bin.
    lock)     exec "$(dirname "$0")/x11-lock" ;;
    suspend)  exec systemctl suspend ;;
    logout)   exec i3-msg exit ;;
    reboot)   exec systemctl reboot ;;
    poweroff) exec systemctl poweroff ;;
    "power profile:"*)
        pick=$(powerprofilesctl list | sed -n 's/^[ *]*\([a-z-]*\):$/\1/p' | rofi -dmenu -i -p 'power profile') || exit 0
        powerprofilesctl set "$pick" && dunstify -a cachy-dots -r 9986 "Power profile" "$pick" ;;
esac
