# ~/.xprofile — sourced by the session before the desktop starts, so everything
# below applies to the whole session rather than just this file's shell.
#
# XDG_CURRENT_DESKTOP: a bare i3 session names no desktop, and the xdg-desktop-portal
# GTK backend is gated on it. Its descriptor, /usr/share/xdg-desktop-portal/portals/gtk.portal,
# declares `UseIn=gnome`, so without this variable the backend is skipped, the
# org.freedesktop.portal.Settings interface is unavailable, and anything that asks
# the portal for the system colour scheme - qutebrowser among them - falls back to
# light. i3 has no way to export this itself; it has no set_environment directive.
#
# Harmless for GTK, which ignores the extra token, but it is a lie either way:
# naming GNOME is simply the only way to get that portal backend loaded here.
# Appended, not defaulted: ly sets XDG_CURRENT_DESKTOP=i3 from the session file
# before sourcing this, so a `${XDG_CURRENT_DESKTOP:-GNOME}` default would never
# fire and the portal would still skip its GTK backend. The value is a
# colon-separated list, and the portal matches any of its tokens.
#
# PATH: bin/ is linked into ~/.local/bin, and nothing on CachyOS adds that to the
# session's PATH, so rofi and anything else i3 spawns would not find the helpers.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Telemetry opt-outs for everything i3 starts (env/telemetry.conf; the same file
# systemd --user reads through environment.d).
if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/telemetry.conf" ]; then
    set -a
    . "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/telemetry.conf"
    set +a
fi

# Qt takes its palette from GTK3 (qt6-base's gtk3 platform theme), and GTK3 is
# recoloured by the theme's gtk.css, so Qt apps (CopyQ, qutebrowser's dialogs)
# follow the theme with no Qt-specific config. Verified on the VM: CopyQ's
# selection went from GTK's blue to the theme accent.
export QT_QPA_PLATFORMTHEME=gtk3

case ":${XDG_CURRENT_DESKTOP:-}:" in
    *:GNOME:*) ;;
    *) export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:+$XDG_CURRENT_DESKTOP:}GNOME" ;;
esac
