# Aliases for eza, zoxide and fzf, matching the Omarchy host's defaults.

# ── eza ───────────────────────────────────────────────────────────────────
if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

# ── fzf ───────────────────────────────────────────────────────────────────
# ff: fuzzy file finder with a preview (bat for text, kitty icat for images).
# eff: open the picked file in $EDITOR. sff: scp the picked file somewhere.
if [[ "$TERM" == "xterm-kitty" ]]; then
  alias ff="fzf --preview 'case \$(file --mime-type -b {}) in image/*) kitty icat --clear --transfer-mode=memory --stdin=no --place=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}@0x0 {} ;; *) bat --style=numbers --color=always {} ;; esac'"
else
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
fi
alias eff='$EDITOR "$(ff)"'
sff() {
  if [ $# -eq 0 ]; then echo "Usage: sff <destination> (e.g. sff host:/tmp/)"; return 1; fi
  local file
  file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) && [ -n "$file" ] && scp "$file" "$1"
}

# ── zoxide ────────────────────────────────────────────────────────────────
# cd falls back to a zoxide jump when the argument is not a directory.
if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi

      printf "\U000F17A9 "
      pwd
    fi
  }
fi

# ── directories ───────────────────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ── vi mode ─────────────────────────────────────────────────────────────────
# vi-style line editing.
if [ -n "${BASH_VERSION:-}" ]; then
  set -o vi
fi

# ── secure secrets editor ───────────────────────────────────────────────────
# svim: no viminfo, no swap/backup/undo files, no plugins — secrets never touch
# disk outside the edited file itself. SOPS_EDITOR reuses it for sops decrypts.
alias svim="nvim -u NONE -i NONE -n -c 'set number' -c 'set nowritebackup nobackup noundofile noswapfile'"
export SOPS_EDITOR="nvim -u NONE -i NONE -n -c 'set number' -c 'set nowritebackup nobackup noundofile noswapfile'"
